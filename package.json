{
  "name": "rush-hour-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "node tools/prepare-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/model.test.ts && npm run test:python",
    "test:python": "python -B -m unittest discover -s tests/python -v",
    "test:browser": "node tools/test-browser.mjs",
    "benchmark": "python -B tools/benchmark.py"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
